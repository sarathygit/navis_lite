# Copy this file to .env and adjust values as needed.
# docker-compose reads this automatically.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=navislite_root_pw
MYSQL_DATABASE=navislite_db
MYSQL_USER=navislite_app
MYSQL_PASSWORD=navislite_app_pw
MYSQL_PORT=3306

# ---- Gateway Service (Java / Spring Boot) ----
GATEWAY_PORT=8080
DECKING_ENGINE_URL=http://decking-engine:8000

# ---- Decking Engine (Python / FastAPI) ----
DECKING_ENGINE_PORT=8000

# ---- Dashboard (React) ----
DASHBOARD_PORT=3000
VITE_GATEWAY_API_URL=http://localhost:8080
VITE_DECKING_ENGINE_API_URL=http://localhost:8000
